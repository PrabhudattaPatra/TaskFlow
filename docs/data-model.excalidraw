    {
      "id": "note",
      "type": "text",
      "x": 20,
      "y": 1130,
      "width": 884,
      "height": 100,
      "angle": 0,
      "autoResize": true,
      "backgroundColor": "transparent",
      "boundElements": null,
      "containerId": null,
      "fillStyle": "solid",
      "fontFamily": 1,
      "fontSize": 16,
      "frameId": null,
      "groupIds": [],
      "index": "aU",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "Arrows point from the foreign key to the primary key it references.\nusers <-> projects is many-to-many through project_members (role = owner | member).\nON DELETE CASCADE: deleting a project removes its members, tasks, comments and activity.\nON DELETE SET NULL: tasks.assignee_id / created_by, comments.author_id, activities.actor_id,\nso removing a member never deletes the tasks they created (they are also auto-unassigned).",
      "roughness": 1,
      "roundness": null,
      "seed": 175593967,
      "strokeColor": "#495057",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "Arrows point from the foreign key to the primary key it references.\nusers <-> projects is many-to-many through project_members (role = owner | member).\nON DELETE CASCADE: deleting a project removes its members, tasks, comments and activity.\nON DELETE SET NULL: tasks.assignee_id / created_by, comments.author_id, activities.actor_id,\nso removing a member never deletes the tasks they created (they are also auto-unassigned).",
      "textAlign": "left",
      "updated": 1794470084288,
      "version": 1,
      "versionNonce": 1003952697,
      "verticalAlign": "top"
    },
